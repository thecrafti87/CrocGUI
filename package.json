{
  "name": "croc-gui",
  "version": "1.13.0",
  "description": "Desktop-Oberflaeche fuer croc - sicher Dateien zwischen Rechnern uebertragen",
  "main": "src/main/main.js",
  "author": "thecrafti87",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/thecrafti87/CrocGUI.git"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "electron .",
    "fetch-croc": "node scripts/fetch-croc.js",
    "fetch-croc:latest": "node scripts/fetch-croc.js --latest",
    "fetch-croc:all": "node scripts/fetch-croc.js --all",
    "dist": "node scripts/fetch-croc.js && electron-builder",
    "dist:mac": "node scripts/fetch-croc.js --platform darwin && electron-builder --mac",
    "dist:win": "node scripts/fetch-croc.js --platform win32 && electron-builder --win",
    "dist:linux": "node scripts/fetch-croc.js --platform linux && electron-builder --linux"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "de.crocgui.app",
    "productName": "CrocGUI",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Beliebige Datei",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.item",
              "public.folder"
            ],
            "LSHandlerRank": "Alternate"
          }
        ]
      },
      "extraResources": [
        {
          "from": "vendor/darwin-${arch}",
          "to": ".",
          "filter": [
            "croc",
            "VERSION"
          ]
        },
        {
          "from": "assets",
          "to": ".",
          "filter": [
            "icon.png",
            "crocTemplate.png",
            "crocTemplate@2x.png"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "assets/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/win32-${arch}",
          "to": ".",
          "filter": [
            "croc.exe",
            "VERSION"
          ]
        },
        {
          "from": "assets",
          "to": ".",
          "filter": [
            "icon.png",
            "crocTemplate.png",
            "crocTemplate@2x.png"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrocGUI",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Dateien sicher zwischen Rechnern uebertragen",
      "maintainer": "thecrafti87",
      "desktop": {
        "entry": {
          "StartupWMClass": "CrocGUI"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/linux-${arch}",
          "to": ".",
          "filter": [
            "croc",
            "VERSION"
          ]
        },
        {
          "from": "assets",
          "to": ".",
          "filter": [
            "icon.png",
            "crocTemplate.png",
            "crocTemplate@2x.png"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thecrafti87",
        "repo": "CrocGUI",
        "releaseType": "release"
      }
    ]
  },
  "crocVersion": "11.2.4"
}
